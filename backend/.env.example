PROJECT_NAME=RouteFloww
PORT=5000
NODE_ENV=development

DATABASE_URL=postgresql://postgres:password@localhost:5432/routefloww
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=replace-with-a-server-only-service-role-key

JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_REFRESH_SECRET=replace-with-a-different-32-character-secret
JWT_ACCESS_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=7d

APP_BASE_URL=http://localhost:8081
INVITATION_EXPIRES_HOURS=48
LOCATION_STALE_AFTER_SECONDS=120
LOCATION_MIN_UPDATE_SECONDS=10
MAX_PROOF_FILE_BYTES=8388608
# Exactly one delivery confirmation system must be true.
DELIVERY_PHOTO_PROOF_ENABLED=true
DELIVERY_OTP_PROOF_ENABLED=false
# Leave blank to keep protected proof files in PostgreSQL. When configured,
# create this as a private Supabase Storage bucket before accepting proofs.
PROOF_STORAGE_BUCKET=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_SENDER_EMAIL=
GOOGLE_SENDER_NAME=RouteFloww Team

# Location lookup providers. Providers without a key are skipped automatically.
# Google requires Places API (New) and Geocoding API on this server key.
GOOGLE_MAPS_API_KEY=
TOMTOM_API_KEY=
GEOAPIFY_API_KEY=
LOCATION_PROVIDER_ORDER=google,tomtom,geoapify
LOCATION_GOOGLE_ENABLED=true
LOCATION_TOMTOM_ENABLED=true
LOCATION_GEOAPIFY_ENABLED=true
LOCATION_FALLBACK_ON_EMPTY_RESULTS=true
LOCATION_PROVIDER_COOLDOWN_SECONDS=900
LOCATION_REQUEST_TIMEOUT_MS=8000
OCR_SPACE_API_KEY=
OPTIMIZATION_API_URL=

# Comma-separated browser origins. Native apps do not send an Origin header.
CORS_ORIGINS=http://localhost:8081,http://127.0.0.1:8081,http://localhost:19006,http://localhost:3000
GEMINI_API_KEY=replace-with-a-server-side-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash
