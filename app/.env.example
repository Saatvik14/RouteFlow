EXPO_PUBLIC_API_BASE_URL=http://localhost:5000

# Google map display. These are client keys and must have platform restrictions.
EXPO_PUBLIC_GOOGLE_MAPS_ENABLED=true
GOOGLE_MAPS_ANDROID_API_KEY=
GOOGLE_MAPS_IOS_API_KEY=
EXPO_PUBLIC_GOOGLE_MAPS_WEB_API_KEY=

# First map fallback. This client-visible key should be restricted in TomTom.
EXPO_PUBLIC_TOMTOM_MAPS_ENABLED=true
EXPO_PUBLIC_TOMTOM_MAPS_API_KEY=
