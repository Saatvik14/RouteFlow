{
  "expo": {
    "name": "RouteFloww",
    "slug": "app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/image.png",
    "scheme": ["routefloww", "routeflow", "app"],
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/image.png",
      "associatedDomains": [
        "applinks:routefloww.com"
      ],
      "infoPlist": {
        "NSFaceIDUsageDescription": "RouteFloww uses Face ID to secure your account and protect your delivery data.",
        "NSSpeechRecognitionUsageDescription": "Allow RouteFloww to use speech recognition.",
        "NSMicrophoneUsageDescription": "Allow RouteFloww to use the microphone."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/image.png",
        "backgroundImage": "./assets/images/image.png",
        "monochromeImage": "./assets/images/image.png"
      },
      "intentFilters": [
        {
          "action": "VIEW",
          "data": [
            {
              "scheme": "routefloww"
            },
            {
              "scheme": "routeflow"
            },
            {
              "scheme": "app"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        },
        {
          "action": "VIEW",
          "autoVerify": false,
          "data": [
            {
              "scheme": "https",
              "host": "routefloww.com",
              "pathPrefix": "/marketplace"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ],
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.USE_BIOMETRIC",
        "android.permission.RECORD_AUDIO",
        "android.permission.USE_FINGERPRINT",
        "android.permission.POST_NOTIFICATIONS"
      ],
      "package": "com.vvdevill.app"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon-max.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/image.png",
          "color": "#2563EB"
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "android": {
            "image": "./assets/images/image.png",
            "imageWidth": 104
          }
        }
      ],
      "./node_modules/@maplibre/maplibre-react-native/app.plugin.js",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow RouteFloww to use your location."
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Allow RouteFloww to use the microphone.",
          "speechRecognitionPermission": "Allow RouteFloww to use speech recognition.",
          "androidSpeechServicePackages": [
            "com.google.android.googlequicksearchbox"
          ]
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "RouteFloww uses Face ID to secure your account."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "enableBundleCompression": true
          }
        }
      ],
      "expo-secure-store",
      "expo-iap"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "da6e074b-2c2f-405b-9e3e-3468536d474a"
      }
    },
    "owner": "saatvik_142"
  }
}
